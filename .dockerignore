# Allow-list: only what the images need is sent to Docker. Everything else stays on the Mac,
# including node_modules (macOS binaries), build output, the desktop app (src-tauri, release),
# .env.development, local .env overrides and any test data.
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!index.html
!.env.production
!public/
!src/
!docker/
